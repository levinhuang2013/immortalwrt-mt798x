#!/bin/sh

. /lib/functions.sh

board="$(board_name)"

case "$board" in
    sx,7981r128)
        echo "[7981R128] Initializing SSID auto-suffix..."

        #
        # Detect the Factory partition in MTD
        #
        FACTORY_MTD=$(grep -i '"Factory"' /proc/mtd | cut -d: -f1)

        if [ -z "$FACTORY_MTD" ]; then
            echo "[1981R128] ERROR: Factory partition not found in /proc/mtd"
            exit 0
        fi

        FACTORY="/dev/${FACTORY_MTD}"

        if [ ! -e "$FACTORY" ]; then
            echo "[7981R128] ERROR: Factory device ${FACTORY} does not exist"
            exit 0
        fi

        #
        # Read 2 bytes from Factory offset 0x08 as SSID suffix
        #
        mac_suffix="$(
            hexdump -s 0x8 -n 2 "$FACTORY" 2>/dev/null \
            | head -n 1 \
            | tr -d ' ' \
            | tr -d '\n' \
            | tail -c 4
        )"

        if [ -z "$mac_suffix" ]; then
            echo "[7981R128] ERROR: Failed to read SSID suffix from ${FACTORY}"
            exit 0
        fi

        echo "[7981R128] SSID suffix detected: ${mac_suffix}"

        #
        # Update default SSID in Mediatek WiFi dat files
        #
        sed -i "s/ImmortalWrt-2.4G/7981R128_${mac_suffix}/g" \
            /etc/wireless/mediatek/mt7981.dbdc.b0.dat 2>/dev/null

        sed -i "s/ImmortalWrt-5G/7981R128_5G_${mac_suffix}/g" \
            /etc/wireless/mediatek/mt7981.dbdc.b1.dat 2>/dev/null

        echo "[7981R128] SSID updated successfully."
        ;;
esac

exit 0
