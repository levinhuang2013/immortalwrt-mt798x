#!/bin/sh

. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

mediatek_setup_interfaces()
{
	local board="$1"

	case $board in
	zyxel,ex5700)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" eth1
		;;
	*)
		ucidef_set_interfaces_lan_wan "lan0 lan1 lan2 lan3 lan4 lan5" eth1
		;;
	esac
}

mediatek_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local part_name="Factory"
	
	case $board in
	zyxel,ex5700)
		wifi_mac=$(mtd_get_mac_binary Factory 0x04)
		wan_mac=$(mtd_get_mac_binary "Factory" "0x24")
		lan_mac=$(mtd_get_mac_binary "Factory" "0x2a")
		label_mac=$lan_mac
		local b0dat="$(l1dat if2dat ra0)"
		local b1dat="$(l1dat if2dat rax0)"
		local b2dat="$(l1dat if2dat rai0)"
		local b3dat="$(l1dat if2dat ray0)"
		if [ -f ${b0dat} ] && ! grep -q "MacAddress=" ${b0dat}; then
			local b0mac="$wifi_mac"
			echo "MacAddress=$b0mac" >> ${b0dat}
		fi
		if [ -f ${b1dat} ] && ! grep -q "MacAddress=" ${b1dat}; then
			local b1mac="$(macaddr_add $wifi_mac 2)"
			echo "MacAddress=$b1mac" >> ${b1dat}
		fi
		if [ -f ${b2dat} ] && ! grep -q "MacAddress=" ${b2dat}; then
			local b2mac="$(macaddr_add $wifi_mac -1)"
			echo "MacAddress=$b2mac" >> ${b2dat}
		fi
		if [ -f ${b3dat} ] && ! grep -q "MacAddress=" ${b3dat}; then
			local b3mac="$(macaddr_add $wifi_mac -2)"
			echo "MacAddress=$b3mac" >> ${b3dat}
		fi
		;;
	*)
		lan_mac=$(mtd_get_mac_binary "Factory" "0x2A")
		wan_mac=$(mtd_get_mac_binary "Factory" "0x24")
		;;
	esac

	case "$lan_mac" in
		00:00:00:00:00:00);;
		ff:ff:ff:ff:ff:ff);;
		*)
		[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	;;
	esac

	case "$wan_mac" in
		00:00:00:00:00:00);;
		ff:ff:ff:ff:ff:ff);;
		*)
		[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	;;
	esac
}

board_config_update
board=$(board_name)
mediatek_setup_interfaces $board
mediatek_setup_macs $board
board_config_flush

exit 0
